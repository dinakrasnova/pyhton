  function markFieldError(selectEl, hasError) {
    var group = selectEl.closest(".form-group");
    if (!group) return;
    var errorEl = group.querySelector(".field-error");
    if (hasError) {
      selectEl.style.borderColor = "#b91c1c";
      selectEl.style.boxShadow = "0 0 0 1px rgba(185,28,28,0.25)";
      if (errorEl) errorEl.style.display = "block";
    } else {
      selectEl.style.borderColor = "rgba(209,213,219,0.9)";
      selectEl.style.boxShadow = "none";
      if (errorEl) errorEl.style.display = "none";
    }
  }

  var calcForm = document.getElementById("priceCalculator");
  if (calcForm) {
    calcForm.addEventListener("submit", function (e) {
      e.preventDefault();
      var opf = document.getElementById("opf");
      var tax = document.getElementById("taxSystem");
      var act = document.getElementById("activity");
      var ops = document.getElementById("operations");
      var emp = document.getElementById("employees");
      var regionInputs = document.querySelectorAll("input[name='region']");

      var valid = true;
      [opf, tax, act, ops, emp].forEach(function (el) {
        if (!el.value) {
          valid = false;
          markFieldError(el, true);
        } else {
          markFieldError(el, false);
        }
      });

      var regionVal = "msk";
      regionInputs.forEach(function (r) {
        if (r.checked) regionVal = r.value;
      });

      var messageEl = document.getElementById("calcMessage");
      var resultValueEl = document.getElementById("calcResultValue");
      var resultNoteEl = document.getElementById("calcResultNote");

      if (!valid) {
        if (messageEl) {
          messageEl.textContent = "Пожалуйста, заполните обязательные поля.";
          messageEl.style.color = "#b91c1c";
        }
        if (resultValueEl) {
          resultValueEl.textContent = "— ₽ в месяц";
        }
        return;
      }

      // Базовая ставка
      var basePrice = null;
      if (opf.value === "self") {
        basePrice = pricingConfig.base.self.any;
      } else {
        var baseGroup = pricingConfig.base[opf.value] || {};
        basePrice = baseGroup[tax.value] != null ? baseGroup[tax.value] : null;
      }

      if (basePrice == null) {
        if (messageEl) {
          messageEl.textContent = "Для такой комбинации параметров расчёт онлайн недоступен — свяжитесь со мной для индивидуального расчёта.";
          messageEl.style.color = "#b91c1c";
        }
        if (resultValueEl) {
          resultValueEl.textContent = "Свяжитесь для расчёта";
        }
        if (resultNoteEl) {
          resultNoteEl.textContent = "Я подберу формат обслуживания и стоимость после краткой консультации.";
        }
        return;
      }

      // Шаги расчёта
      var price = basePrice;

      // Вид деятельности
      var actCoef = pricingConfig.activity[act.value] || 1.0;
      price = price * actCoef;

      // Операции
      var opsCoef = pricingConfig.operations[ops.value] || 1.0;
      price = price * opsCoef;

      // Сотрудники
      var empAdd = pricingConfig.employees[emp.value] || 0;
      price = price + empAdd;

      // Опции (процент)
      var optionsPerc = 0;
      if (document.getElementById("optPayroll").checked) optionsPerc += pricingConfig.optionsPercent.payroll;
      if (document.getElementById("optLegal").checked) optionsPerc += pricingConfig.optionsPercent.legal;
      if (document.getElementById("optVat").checked) optionsPerc += pricingConfig.optionsPercent.vat;
      price = price * (1 + optionsPerc);

      // Регион
      var regCoef = pricingConfig.region[regionVal] || 1.0;
      price = price * regCoef;

      // Округление
      var finalPrice = roundTo100(price);

      if (resultValueEl) {
        resultValueEl.textContent = finalPrice.toLocaleString("ru-RU") + " ₽ в месяц";
      }
      if (resultNoteEl) {
        resultNoteEl.textContent = "Расчёт предварительный и не является публичной офертой. Точная сумма определяется после консультации.";
      }
      if (messageEl) {
        messageEl.textContent = "Расчёт выполнен. Можно отправить расчёт и получить персональное предложение.";
        messageEl.style.color = "#16a34a";
      }
    });
  }
</script>
</body>
</html>
