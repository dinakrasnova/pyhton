<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Онлайн‑бухгалтер для ИП и малого бизнеса</title>
  <style>
    :root {
      --bg: #f5f8fb;
      --bg-light: #ffffff;
      --primary: #1f7aa8;
      --primary-soft: #e0f2ff;
      --accent: #1a936f;
      --text: #1f2933;
      --muted: #6b7280;
      --border: #d1d5db;
      --danger: #b91c1c;
      --shadow-soft: 0 10px 25px rgba(15, 23, 42, 0.08);
      --radius-lg: 16px;
      --radius-md: 12px;
      --radius-sm: 8px;
      --transition-fast: 0.2s ease;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.5;
    }

    img {
      max-width: 100%;
      display: block;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button {
      font-family: inherit;
    }

    /* Layout */

    .page {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    .container {
      width: 100%;
      max-width: 1120px;
      margin: 0 auto;
      padding: 0 16px;
    }

    section {
      padding: 64px 0;
    }

    @media (max-width: 768px) {
      section {
        padding: 48px 0;
      }
    }

    .section-title {
      font-size: 28px;
      font-weight: 700;
      margin-bottom: 16px;
      text-align: left;
    }

    .section-subtitle {
      font-size: 16px;
      color: var(--muted);
      margin-bottom: 32px;
      max-width: 540px;
    }

    /* Header / Hero */

    .header {
      position: sticky;
      top: 0;
      z-index: 20;
      background: rgba(245, 248, 251, 0.9);
      backdrop-filter: blur(16px);
      border-bottom: 1px solid rgba(209, 213, 219, 0.6);
    }

    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 16px;
      max-width: 1120px;
      margin: 0 auto;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 8px;
      font-weight: 700;
      font-size: 18px;
      color: var(--primary);
    }

    .logo-mark {
      width: 32px;
      height: 32px;
      border-radius: 999px;
      background: linear-gradient(135deg, #1f7aa8, #1a936f);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-size: 18px;
      box-shadow: var(--shadow-soft);
    }

    .nav {
      display: flex;
      gap: 24px;
      align-items: center;
      font-size: 14px;
    }

    .nav a {
      color: var(--muted);
      padding: 6px 0;
      border-bottom: 2px solid transparent;
      transition: color var(--transition-fast), border-color var(--transition-fast);
    }

    .nav a:hover {
      color: var(--primary);
      border-color: var(--primary-soft);
    }

    .nav-cta {
      padding: 8px 16px;
      border-radius: 999px;
      border: 1px solid rgba(31, 122, 168, 0.2);
      color: var(--primary);
      background: rgba(255, 255, 255, 0.9);
      font-weight: 500;
      transition: background var(--transition-fast), box-shadow var(--transition-fast);
    }

    .nav-cta:hover {
      background: #fff;
      box-shadow: var(--shadow-soft);
    }

    @media (max-width: 768px) {
      .nav {
        display: none;
      }
    }

    .hero {
      padding: 40px 0 64px;
    }

    .hero-inner {
      display: grid;
      grid-template-columns: minmax(0, 3fr) minmax(0, 2.5fr);
      gap: 40px;
      align-items: center;
    }

    @media (max-width: 900px) {
      .hero-inner {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 4px 10px 4px 4px;
      border-radius: 999px;
      background: rgba(26, 147, 111, 0.08);
      color: var(--accent);
      font-size: 12px;
      margin-bottom: 16px;
    }

    .hero-badge-dot {
      width: 20px;
      height: 20px;
      border-radius: 999px;
      background: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 0 0 1px rgba(16, 185, 129, 0.3), 0 6px 12px rgba(16, 185, 129, 0.25);
      font-size: 12px;
    }

    .hero-title {
      font-size: 32px;
      line-height: 1.2;
      font-weight: 800;
      margin-bottom: 12px;
    }

    .hero-subtitle {
      font-size: 16px;
      color: var(--muted);
      max-width: 520px;
      margin-bottom: 20px;
    }

    .hero-list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 10px 24px;
      margin-bottom: 24px;
      font-size: 14px;
    }

    .hero-list-item {
      display: flex;
      gap: 8px;
      align-items: flex-start;
      color: var(--text);
    }

    .hero-list-icon {
      width: 18px;
      height: 18px;
      border-radius: 999px;
      background: var(--primary-soft);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--primary);
      font-size: 11px;
      flex-shrink: 0;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      align-items: center;
      margin-bottom: 16px;
    }

    .btn-primary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: none;
      border-radius: 999px;
      padding: 12px 22px;
      background: linear-gradient(135deg, #1f7aa8, #1a5faf);
      color: #fff;
      font-weight: 600;
      font-size: 15px;
      cursor: pointer;
      box-shadow: 0 14px 28px rgba(31, 122, 168, 0.35);
      transition: transform var(--transition-fast), box-shadow var(--transition-fast), filter var(--transition-fast);
      text-decoration: none;
      white-space: nowrap;
    }

    .btn-primary:hover {
      transform: translateY(-1px);
      box-shadow: 0 18px 34px rgba(31, 122, 168, 0.4);
      filter: brightness(1.02);
    }

    .btn-outline {
      border-radius: 999px;
      padding: 11px 20px;
      border: 1px solid rgba(31, 122, 168, 0.35);
      background: rgba(255, 255, 255, 0.9);
      color: var(--primary);
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 14px;
      cursor: pointer;
      transition: background var(--transition-fast), box-shadow var(--transition-fast);
    }

    .btn-outline:hover {
      background: #fff;
      box-shadow: var(--shadow-soft);
    }

    .btn-outline-icon {
      width: 18px;
      height: 18px;
      border-radius: 999px;
      background: #1f7aa8;
      color: #fff;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 11px;
    }

    .hero-note {
      font-size: 12px;
      color: var(--muted);
    }

    .hero-note strong {
      color: var(--accent);
    }

    .hero-side {
      position: relative;
    }

    .hero-card {
      background: radial-gradient(circle at top left, #e0f2ff, #ffffff 50%);
      border-radius: 26px;
      padding: 22px 20px;
      box-shadow: 0 24px 40px rgba(15, 23, 42, 0.12);
      border: 1px solid rgba(148, 163, 184, 0.3);
    }

    .hero-avatar {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 14px;
    }

    .hero-avatar-circle {
      width: 56px;
      height: 56px;
      border-radius: 50%;
      background: linear-gradient(135deg, #1a936f, #1f7aa8);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-size: 26px;
      font-weight: 700;
      box-shadow: 0 18px 30px rgba(31, 122, 168, 0.4);
      flex-shrink: 0;
    }

    .hero-avatar-info {
      font-size: 13px;
    }

    .hero-avatar-name {
      font-weight: 600;
      margin-bottom: 2px;
    }

    .hero-avatar-role {
      color: var(--muted);
      font-size: 12px;
      margin-bottom: 4px;
    }

    .hero-avatar-meta {
      font-size: 11px;
      color: var(--muted);
    }

    .hero-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 10px;
      border-radius: 999px;
      background: rgba(22, 163, 74, 0.06);
      color: #166534;
      font-size: 11px;
      margin-bottom: 12px;
    }

    .hero-pill-dot {
      width: 8px;
      height: 8px;
      border-radius: 999px;
      background: #22c55e;
      box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.35);
    }

    .hero-card-list {
      list-style: none;
      margin-bottom: 14px;
      font-size: 13px;
      color: var(--muted);
    }

    .hero-card-list li {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 6px;
    }

    .hero-card-list li span {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #1f7aa8;
      opacity: 0.3;
    }

    .hero-stats {
      display: flex;
      gap: 16px;
      margin-top: 8px;
      font-size: 12px;
    }

    .hero-stat {
      flex: 1;
      padding: 8px 10px;
      border-radius: 12px;
      background: rgba(15, 23, 42, 0.04);
    }

    .hero-stat-label {
      color: var(--muted);
      font-size: 11px;
      margin-bottom: 4px;
    }

    .hero-stat-value {
      font-weight: 700;
      font-size: 13px;
    }

    /* "Кому подойдёт" */

    .chips-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 12px;
    }

    .chip-card {
      background: var(--bg-light);
      border-radius: var(--radius-md);
      padding: 12px 14px;
      border: 1px solid rgba(209, 213, 219, 0.7);
      display: flex;
      align-items: flex-start;
      gap: 10px;
      font-size: 14px;
      box-shadow: 0 10px 18px rgba(15, 23, 42, 0.04);
    }

    .chip-icon {
      width: 20px;
      height: 20px;
      border-radius: 999px;
      background: rgba(31, 122, 168, 0.08);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--primary);
      font-size: 12px;
      flex-shrink: 0;
    }

    /* Услуги */

    .services-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 18px;
    }

    .service-card {
      background: var(--bg-light);
      border-radius: var(--radius-lg);
      padding: 18px 18px 16px;
      border: 1px solid rgba(209, 213, 219, 0.9);
      box-shadow: 0 12px 24px rgba(15, 23, 42, 0.06);
      position: relative;
      overflow: hidden;
    }

    .service-card::before {
      content: "";
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at top left, rgba(31, 122, 168, 0.08), transparent 55%);
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--transition-fast);
    }

    .service-card:hover::before {
      opacity: 1;
    }

    .service-icon {
      width: 32px;
      height: 32px;
      border-radius: 12px;
      background: rgba(31, 122, 168, 0.08);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--primary);
      margin-bottom: 8px;
      font-size: 16px;
    }

    .service-title {
      font-size: 16px;
      font-weight: 600;
      margin-bottom: 6px;
    }

    .service-desc {
      font-size: 14px;
      color: var(--muted);
      margin-bottom: 8px;
    }

    .service-tag {
      display: inline-flex;
      align-items: center;
      padding: 4px 9px;
      border-radius: 999px;
      background: rgba(26, 147, 111, 0.07);
      color: #166534;
      font-size: 11px;
      border: 1px solid rgba(34, 197, 94, 0.25);
    }

    /* Резерв под калькулятор */

    .calculator-placeholder {
      margin-top: 32px;
      margin-bottom: 8px;
      background: linear-gradient(90deg, rgba(31, 122, 168, 0.08), rgba(26, 147, 111, 0.02));
      border-radius: var(--radius-lg);
      padding: 16px 18px;
      border: 1px dashed rgba(148, 163, 184, 0.8);
      font-size: 13px;
      color: var(--muted);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      flex-wrap: wrap;
    }

    .calculator-pill {
      padding: 4px 10px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.9);
      border: 1px solid rgba(148, 163, 184, 0.6);
      font-size: 11px;
      color: var(--text);
    }

    /* Тарифы */

    .pricing-intro {
      font-size: 14px;
      color: var(--muted);
      margin-bottom: 16px;
    }

    .pricing-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 18px;
      margin-bottom: 18px;
    }

    .pricing-card {
      background: var(--bg-light);
      border-radius: var(--radius-lg);
      border: 1px solid rgba(209, 213, 219, 0.9);
      padding: 18px 18px 16px;
      display: flex;
      flex-direction: column;
      box-shadow: 0 12px 24px rgba(15, 23, 42, 0.06);
    }

    .pricing-card.featured {
      border-color: rgba(31, 122, 168, 0.7);
      box-shadow: 0 18px 34px rgba(31, 122, 168, 0.25);
      position: relative;
      overflow: hidden;
    }

    .pricing-card.featured::before {
      content: "Популярный тариф";
      position: absolute;
      top: 12px;
      right: -40px;
      transform: rotate(40deg);
      background: linear-gradient(135deg, #1f7aa8, #1a936f);
      color: #fff;
      font-size: 10px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      padding: 4px 32px;
      box-shadow: 0 10px 20px rgba(31, 122, 168, 0.3);
    }

    .pricing-name {
      font-size: 16px;
      font-weight: 700;
      margin-bottom: 6px;
    }

    .pricing-sub {
      font-size: 13px;
      color: var(--muted);
      margin-bottom: 8px;
    }

    .pricing-price {
      font-size: 22px;
      font-weight: 800;
      margin-bottom: 2px;
      color: var(--primary);
    }

    .pricing-note {
      font-size: 12px;
      color: var(--muted);
      margin-bottom: 10px;
    }

    .pricing-list {
      font-size: 13px;
      color: var(--text);
      list-style: none;
      margin-bottom: 12px;
    }

    .pricing-list li {
      display: flex;
      gap: 8px;
      align-items: flex-start;
      margin-bottom: 5px;
    }

    .pricing-list li span {
      color: var(--primary);
      margin-top: 2px;
      font-size: 12px;
    }

    .pricing-footer {
      margin-top: auto;
      font-size: 12px;
      color: var(--muted);
    }

    .pricing-cta-wrapper {
      display: flex;
      justify-content: flex-start;
    }

    /* Обо мне */

    .about-grid {
      display: grid;
      grid-template-columns: minmax(0, 2.2fr) minmax(0, 2fr);
      gap: 24px;
      align-items: center;
    }

    @media (max-width: 900px) {
      .about-grid {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    .about-card {
      background: var(--bg-light);
      border-radius: var(--radius-lg);
      padding: 18px 18px 16px;
      border: 1px solid rgba(209, 213, 219, 0.9);
      box-shadow: 0 12px 24px rgba(15, 23, 42, 0.06);
    }

    .about-header {
      display: flex;
      gap: 14px;
      align-items: center;
      margin-bottom: 10px;
    }

    .about-photo {
      width: 70px;
      height: 70px;
      border-radius: 999px;
      background: linear-gradient(135deg, #e0f2ff, #f97316);
      position: relative;
      overflow: hidden;
      box-shadow: 0 16px 28px rgba(15, 23, 42, 0.2);
      flex-shrink: 0;
    }

    .about-photo::after {
      content: "Фото";
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      color: rgba(15, 23, 42, 0.7);
      font-size: 12px;
      font-weight: 600;
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.35), transparent);
    }

    .about-meta {
      font-size: 13px;
    }

    .about-name {
      font-weight: 700;
      margin-bottom: 2px;
    }

    .about-role {
      font-size: 12px;
      color: var(--muted);
      margin-bottom: 6px;
    }

    .about-badges {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .badge {
      padding: 3px 8px;
      border-radius: 999px;
      background: rgba(31, 122, 168, 0.06);
      color: var(--primary);
      font-size: 11px;
    }

    .about-text {
      font-size: 14px;
      color: var(--text);
      margin-bottom: 10px;
    }

    .facts-list {
      list-style: none;
      font-size: 13px;
      color: var(--text);
    }

    .facts-list li {
      display: flex;
      gap: 8px;
      margin-bottom: 6px;
    }

    .facts-list li span {
      color: var(--primary);
      font-size: 12px;
      margin-top: 2px;
    }

    .logos-row {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      align-items: center;
      font-size: 12px;
      color: var(--muted);
    }

    .logo-badge {
      padding: 5px 10px;
      border-radius: 999px;
      border: 1px solid rgba(148, 163, 184, 0.8);
      background: #fff;
      font-weight: 500;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .logo-dot {
      width: 8px;
      height: 8px;
      border-radius: 999px;
      background: #f97316;
    }

    /* Как работаем */

    .steps-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 16px;
    }

    .step-card {
      background: var(--bg-light);
      border-radius: var(--radius-md);
      padding: 14px 16px;
      border: 1px solid rgba(209, 213, 219, 0.85);
      box-shadow: 0 10px 18px rgba(15, 23, 42, 0.05);
      position: relative;
      overflow: hidden;
    }

    .step-number {
      width: 26px;
      height: 26px;
      border-radius: 999px;
      background: rgba(31, 122, 168, 0.08);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--primary);
      font-size: 13px;
      font-weight: 600;
      margin-bottom: 6px;
    }

    .step-title {
      font-size: 14px;
      font-weight: 600;
      margin-bottom: 4px;
    }

    .step-text {
      font-size: 13px;
      color: var(--muted);
    }

    /* FAQ */

    .faq-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      gap: 24px;
      align-items: flex-start;
    }

    @media (max-width: 900px) {
      .faq-grid {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    .faq-intro-card {
      background: linear-gradient(145deg, #1f7aa8, #1a936f);
      border-radius: var(--radius-lg);
      padding: 18px 18px 16px;
      color: #e5f4ff;
      box-shadow: 0 18px 34px rgba(15, 23, 42, 0.3);
      position: sticky;
      top: 88px;
    }

    @media (max-width: 900px) {
      .faq-intro-card {
        position: static;
      }
    }

    .faq-intro-card h3 {
      font-size: 18px;
      margin-bottom: 8px;
    }

    .faq-intro-card p {
      font-size: 13px;
      margin-bottom: 10px;
      color: rgba(241, 245, 249, 0.95);
    }

    .faq-intro-note {
      font-size: 12px;
      color: rgba(226, 232, 240, 0.9);
    }

    .faq-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 11px;
      padding: 3px 9px;
      border-radius: 999px;
      background: rgba(15, 23, 42, 0.25);
      margin-bottom: 8px;
    }

    .faq-badge-dot {
      width: 8px;
      height: 8px;
      border-radius: 999px;
      background: #fbbf24;
      box-shadow: 0 0 0 3px rgba(251, 191, 36, 0.5);
    }

    .faq-list {
      background: var(--bg-light);
      border-radius: var(--radius-lg);
      padding: 8px 12px;
      border: 1px solid rgba(209, 213, 219, 0.9);
      box-shadow: 0 12px 24px rgba(15, 23, 42, 0.06);
    }

    .faq-item {
      border-bottom: 1px solid rgba(209, 213, 219, 0.7);
    }

    .faq-item:last-child {
      border-bottom: none;
    }

    .faq-question {
      width: 100%;
      padding: 10px 0;
      border: none;
      background: transparent;
      color: var(--text);
      font-size: 14px;
      text-align: left;
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 12px;
      cursor: pointer;
    }

    .faq-question span {
      flex: 1;
    }

    .faq-icon {
      width: 22px;
      height: 22px;
      border-radius: 999px;
      border: 1px solid rgba(148, 163, 184, 0.9);
      display: flex;
      align-items: center;
      justify-content: center;
